"}, {"title": "电机控制工程师", "why": "电子设计竞赛省二等奖项目为基于STM32的直流电机闭环调速系统，具备电机闭环控制硬件搭建与C语言编程能力。", "from_db": false, "db_level": "inferred"}, {"title": "嵌入式硬件工程师", "why": "竞赛中用STM32搭建直流电机闭环调速系统，涉及主控电路与驱动电路设计，技能含C语言与STM32，适合嵌入式硬件入口岗。", "from_db": true, "db_level": "campus"}, {"title": "设备管理工程师", "why": "汽车零部件厂设备部实习经历直接对应设备管理，熟悉PLC调试与伺服参数整定，能承担设备维护、故障分析与改善。", "from_db": false, "db_level": "inferred"}, {"title": "工艺工程师", "why": "实习中通过PLC程序与伺服参数优化将产线节拍从58s降到52s，具备产线节拍分析与工艺改善的实操基础。", "from_db": true, "db_level": "campus"}, {"title": "电气测试工程师", "why": "竞赛完成直流电机闭环调速系统搭建与调试，实习完成伺服驱动参数整定，具备电气系统测试与参数验证能力。", "from_db": true, "db_level": "campus"}, {"title": "上位机软件工程师", "why": "技能含组态王与C语言，实习中涉及PLC程序调试与产线数据监控，可承担组态监控与上位机界面开发工作。", "from_db": true, "db_level": "campus"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 15:18:27", "_cg": {"name": "job_recommend_pool", "fp": "5d2a4959583f", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 15:18:27", "extra": {}}}, "6eeb045fea87a1512f59": {"tier": 0, "mode": "llm", "items": [{"title": "电气工程师", "why": "自动化专业核心对口岗位，PLC 调试与伺服参数整定实习经历直接匹配电气控制柜设计与现场调试工作", "from_db": true, "db_level": "campus"}, {"title": "电控软件工程师", "why": "西门子 PLC 程序调试与 STM32 电机闭环调速竞赛经历，对应电控系统软件开发与逻辑编程岗位", "from_db": true, "db_level": "campus"}, {"title": "电机控制算法工程师", "why": "电赛省二等奖的 STM32 直流电机闭环调速系统，是电机控制算法岗最直接的本科项目支撑", "from_db": true, "db_level": "campus"}, {"title": "运动控制算法工程师", "why": "伺服驱动参数整定实习加闭环调速竞赛，覆盖运动控制中的参数辨识与位置/速度环调试", "from_db": true, "db_level": "campus"}, {"title": "过程控制算法工程师", "why": "毕业论文《基于模糊 PID 的注塑机料筒温度控制》与 Simulink 仿真，正对过程控制中的温度/回路控制方向", "from_db": true, "db_level": "campus"}, {"title": "控制工程师", "why": "自动控制原理、PID 整定与 Simulink 建模仿真能力，是控制工程师岗位的通用入口要求", "from_db": true, "db_level": "campus"}, {"title": "嵌入式软件工程师", "why": "STM32 平台 C 语言开发电机闭环调速系统的竞赛经历，支撑嵌入式底层驱动与控制软件开发", "from_db": true, "db_level": "campus"}, {"title": "嵌入式硬件工程师", "why": "电赛中自行搭建 STM32 电机驱动与调速电路，具备原理图、驱动电路与调试的硬件基础", "from_db": true, "db_level": "campus"}, {"title": "设备工程师", "why": "汽车零部件厂设备部实习中调试产线设备、优化节拍，与设备工程师的现场设备维护与改善职责一致", "from_db": true, "db_level": "campus"}, {"title": "自动化工程师", "why": "PLC 编程、组态王上位监控与产线节拍优化经历，对应自动化产线控制系统的集成与调试", "from_db": true, "db_level": "other"}, {"title": "工艺工程师", "why": "产线节拍从 58s 降到 52s 的改善经历体现工艺节拍分析与优化能力，可投制造工艺岗", "from_db": true, "db_level": "campus"}, {"title": "仿真工程师", "why": "毕业论文使用 MATLAB/Simulink 对温度控制系统建模与仿真，具备控制系统建模与仿真验证能力", "from_db": true, "db_level": "other"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 15:19:41", "_cg": {"name": "job_recommend_pool", "fp": "a58c55cae90d", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 15:19:41", "extra": {}}}, "e4699c868fe8ede763e5": {"tier": 1, "mode": "llm", "items": [{"title": "电控硬件工程师", "why": "自动化专业核心出口，PLC 与伺服驱动实习经历可支撑电控硬件方向，且与已展示的电控软件岗形成软硬互补。", "from_db": true, "db_level": "campus"}, {"title": "硬件工程师", "why": "STM32 直流电机闭环调速系统竞赛作品涉及硬件设计与调试，是自动化学生投硬件岗的直接依据。", "from_db": true, "db_level": "campus"}, {"title": "电气测试工程师", "why": "具备 PLC 调试与伺服参数整定经验，熟悉电气系统现场调试与测试流程，适合电气测试入口岗。", "from_db": true, "db_level": "campus"}, {"title": "系统工程师", "why": "自动化专业覆盖控制、电气、软件多环节，Simulink 建模仿真经历体现系统级思维，适合系统工程师校招入口。", "from_db": true, "db_level": "campus"}, {"title": "研发工程师", "why": "毕业论文涉及模糊 PID 控制算法建模与仿真，具备研发岗位所需的分析与建模能力。", "from_db": true, "db_level": "campus"}, {"title": "技术支持工程师", "why": "PLC、组态王等工业现场技能扎实，设备部实习积累产线调试经验，适合面向客户的技术支持岗。", "from_db": true, "db_level": "campus"}, {"title": "现场服务工程师", "why": "有产线设备调试与节拍优化实操经历，能胜任设备现场安装、调试与维护类校招岗位。", "from_db": true, "db_level": "campus"}, {"title": "上位机软件工程师", "why": "掌握 C 语言与组态王，具备 PLC 上位监控系统开发基础，可投上位机软件方向。", "from_db": true, "db_level": "campus"}, {"title": "测试工程师", "why": "竞赛中完成 STM32 闭环调速系统搭建与验证，具备测试方案设计与执行的基础能力。", "from_db": true, "db_level": "campus"}, {"title": "生产计划助理专工", "why": "实习中参与产线节拍优化，理解生产节拍与设备能力，适合生产计划类助理专工入口。", "from_db": true, "db_level": "campus"}, {"title": "维修助理专工", "why": "设备部实习接触西门子 PLC 与伺服驱动调试，具备设备故障排查与维修的技术基础。", "from_db": true, "db_level": "campus"}, {"title": "项目管理工程师", "why": "自动化多学科项目经历（竞赛、论文、产线调试）体现跨环节协调能力，适合项目管理工程师校招岗。", "from_db": true, "db_level": "campus"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 15:19:45", "_cg": {"name": "job_recommend_pool", "fp": "a58c55cae90d", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 15:19:45", "extra": {}}}, "f99e574eb7f61af8de79": {"tier": 2, "mode": "llm", "items": [{"title": "仪表工程师", "why": "PLC 调试与伺服参数整定经历对应工业现场仪表与自控回路的选型、校验和维护。", "from_db": false, "db_level": "inferred"}, {"title": "电气设计工程师", "why": "自动化专业电气信息大类背景，加上 PLC 与组态王技能，可投电气原理图与控制系统设计岗。", "from_db": true, "db_level": "other"}, {"title": "调试工程师", "why": "设备部实习中完成西门子 PLC 程序调试和产线节拍优化，直接匹配现场调试类岗位。", "from_db": false, "db_level": "inferred"}, {"title": "自控工程师", "why": "毕业论文做模糊 PID 温度控制、Simulink 建模仿真，对应流程工业自控系统实施与整定。", "from_db": true, "db_level": "other"}, {"title": "电力运维工程师", "why": "电气信息大类背景可投电力运维，PLC 与电气调试经历支撑设备巡检与故障处理。", "from_db": false, "db_level": "inferred"}, {"title": "试验工程师", "why": "STM32 闭环调速系统竞赛经历体现搭建测试平台、采集与分析试验数据的能力。", "from_db": true, "db_level": "other"}, {"title": "PCB工程师", "why": "电子设计竞赛中基于 STM32 的电机闭环调速系统涉及硬件电路设计与调试。", "from_db": true, "db_level": "campus"}, {"title": "硬件测试工程师", "why": "竞赛硬件系统搭建与 PLC 调试经验，适合做板级与设备级硬件测试。", "from_db": true, "db_level": "other"}, {"title": "设备维护工程师", "why": "汽车零部件厂设备部实习经历对应产线设备维护、故障诊断与参数整定。", "from_db": true, "db_level": "other"}, {"title": "MES工程师", "why": "组态王与 PLC 产线数据采集经验，可支撑制造执行系统的现场实施与运维。", "from_db": true, "db_level": "campus"}, {"title": "标准化工程师", "why": "PLC 程序调试与产线节拍优化经历，适合做电气与控制相关技术标准与文档工作。", "from_db": true, "db_level": "campus"}, {"title": "智能制造管培生", "why": "自动化专业加产线调试、PLC 与仿真技能，匹配智能制造方向的轮岗培养岗。", "from_db": false, "db_level": "inferred"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 15:19:50", "_cg": {"name": "job_recommend_pool", "fp": "a58c55cae90d", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 15:19:50", "extra": {}}}, "57bf1440407973af62e7": {"tier": 3, "mode": "llm", "items": [{"title": "质量工程师", "why": "设备部实习中调试PLC与伺服参数、关注产线节拍，养成按数据核查细节的习惯，适合从质量检验与异常分析入口做起", "from_db": true, "db_level": "campus"}, {"title": "生产管理管培生", "why": "产线节拍从58s降到52s的改善经历，说明能盯现场、协调资源、推动小改进，适合生产管理方向管培入口", "from_db": false, "db_level": "inferred"}, {"title": "生产计划专员", "why": "毕业设计用Simulink做温度控制建模，具备把参数、节拍、产能算清楚的数据意识，适合生产计划排产入口岗", "from_db": false, "db_level": "inferred"}, {"title": "采购专员", "why": "PLC调试与伺服整定需要和供应商设备、备件打交道，沟通与比价核参数的能力可迁移到采购执行岗", "from_db": true, "db_level": "campus"}, {"title": "供应商管理专员", "why": "设备部实习接触零部件与驱动器件，能看懂技术参数并跟进问题整改，适合供应商质量与交期管理入口", "from_db": false, "db_level": "inferred"}, {"title": "技术销售工程师", "why": "有STM32闭环调速竞赛和PLC实操，能把技术方案讲给非技术客户听，适合技术型销售起步", "from_db": false, "db_level": "inferred"}, {"title": "售前技术支持专员", "why": "电子设计竞赛与PLC项目经历，能快速理解客户需求并做方案演示，适合售前支持入口岗", "from_db": false, "db_level": "inferred"}, {"title": "售后技术支持专员", "why": "设备调试与参数整定经验，习惯现场排查故障、写清处理记录，适合售后技术支持岗", "from_db": false, "db_level": "inferred"}, {"title": "项目助理", "why": "竞赛与毕设都是按节点推进的完整项目，具备跟进进度、整理文档、协调多方的基础", "from_db": false, "db_level": "inferred"}, {"title": "仓储物流专员", "why": "设备部实习涉及备件与产线物料流转，做事细致、能盘点对账，适合仓储物流执行岗", "from_db": false, "db_level": "inferred"}, {"title": "EHS专员", "why": "产线调试经历中关注设备安全与现场规范，责任心强、能按制度巡查记录，适合EHS入口岗", "from_db": true, "db_level": "other"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 15:19:54", "_cg": {"name": "job_recommend_pool", "fp": "a58c55cae90d", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 15:19:54", "extra": {}}}, "dbcc3207fc8c7c95f7b4": {"tier": 0, "mode": "rules", "items": [{"title": "项目管理", "why": "企业库在招（非校招公告来源），与专业方向对口", "from_db": true, "db_level": "other"}, {"title": "项目管理工程师", "why": "校招公告里在招，与专业方向对口", "from_db": true, "db_level": "campus"}, {"title": "数据分析师", "why": "校招公告里在招，与专业方向对口", "from_db": true, "db_level": "campus"}, {"title": "数据分析", "why": "校招公告里在招，与专业方向对口", "from_db": true, "db_level": "campus"}, {"title": "数据分析岗", "why": "校招公告里在招，与专业方向对口", "from_db": true, "db_level": "campus"}, {"titl