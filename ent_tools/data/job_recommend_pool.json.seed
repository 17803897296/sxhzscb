 "生产工艺工程师", "why": "发酵工艺优化与正交试验经历可支撑食品生产企业的工艺参数设定、产线工艺维护与改进岗位。", "from_db": false, "db_level": "inferred"}, {"title": "研发助理工程师", "why": "本科毕业论文的菌种配比与发酵曲线测定工作，适合从研发助理岗位切入食品新产品开发。", "from_db": true, "db_level": "other"}, {"title": "食品感官评价专员", "why": "食品感官评价技能对应食品企业产品风味评估、消费者测试与感官质量控制类岗位。", "from_db": false, "db_level": "inferred"}, {"title": "体系工程师", "why": "HACCP体系文件维护与不合格品追溯整改经历，可迁移到食品企业质量体系管理与审核岗位。", "from_db": true, "db_level": "campus"}, {"title": "质量工程师", "why": "品控实习中的不合格品追溯与整改跟踪经验，对应食品制造企业质量工程与质量改进岗位。", "from_db": true, "db_level": "campus"}, {"title": "食品检验工程师", "why": "微生物检测与HPLC技能组合，适合食品检验机构或企业检验中心的检验工程师岗位。", "from_db": false, "db_level": "inferred"}, {"title": "宠物食品研发", "why": "食品大类下的宠物食品研发岗位同样需要发酵工艺、配方设计与品质评价能力，专业口径相通。", "from_db": true, "db_level": "campus"}, {"title": "化学分析工程师", "why": "HPLC操作与检测分析基础可支撑食品、农产品相关企业的化学分析检测岗位。", "from_db": true, "db_level": "campus"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 02:51:03", "_cg": {"name": "job_recommend_pool", "fp": "515b4e47f276", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 02:51:03", "extra": {}}}, "d7e9e628544282ebce83": {"tier": 3, "mode": "llm", "items": [{"title": "学科教师", "why": "不限专业岗位；你已选择愿意考虑教培类企业", "from_db": false}, {"title": "课程顾问", "why": "不限专业岗位；你已选择愿意考虑教培类企业", "from_db": false}, {"title": "学习规划师", "why": "不限专业岗位；你已选择愿意考虑教培类企业", "from_db": false}, {"title": "校区运营管培生", "why": "不限专业岗位；你已选择愿意考虑教培类企业", "from_db": false}, {"title": "教务专员", "why": "不限专业岗位；你已选择愿意考虑教培类企业", "from_db": false}, {"title": "招生专员", "why": "不限专业岗位；你已选择愿意考虑教培类企业", "from_db": false}, {"title": "销售管培生", "why": "食品感官评价和品控实习中对接生产线的沟通经历，可迁移到客户开发与销售轮岗培养。", "from_db": true, "db_level": "campus"}, {"title": "行政专员", "why": "HACCP文件维护、检测记录整理等实习内容体现文档与事务管理能力，适合行政支持岗位。", "from_db": true, "db_level": "campus"}, {"title": "人力资源专员", "why": "品控实习中跟踪整改、协调多方的经历，可迁移到招聘协调、员工关系等人事基础工作。", "from_db": true, "db_level": "campus"}, {"title": "市场专员", "why": "食品创新大赛的工艺优化展示与感官评价经验，可迁移到市场调研、活动执行与品牌推广。", "from_db": true, "db_level": "campus"}, {"title": "数据分析师", "why": "毕业论文使用正交试验和SPSS处理发酵温度与菌种配比数据，具备数据整理与统计分析基础。", "from_db": true, "db_level": "campus"}, {"title": "客户经理", "why": "品控实习中对接生产线取样、追溯与整改跟踪的沟通经验，适合面向客户的维护与拓展岗位。", "from_db": true, "db_level": "campus"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 02:51:07", "_cg": {"name": "job_recommend_pool", "fp": "515b4e47f276", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 02:51:07", "extra": {}}}, "f733ad741043953de76a": {"tier": 0, "mode": "llm", "items": [{"title": "电气工程师", "why": "自动化专业核心对口，电气类课程与控制基础可直接迁移到电气设计、调试与运维岗位。", "from_db": true, "db_level": "campus"}, {"title": "自动化工程师", "why": "专业名称直接对应，校招中常见于设备控制、产线自动化与系统集成方向。", "from_db": true, "db_level": "other"}, {"title": "控制工程师", "why": "自动化专业控制理论、运动控制等课程基础可直接支撑控制系统的开发与调试。", "from_db": true, "db_level": "campus"}, {"title": "嵌入式软件工程师", "why": "自动化专业普遍涉及单片机与嵌入式基础，适合投递嵌入式软件开发入口岗。", "from_db": true, "db_level": "campus"}, {"title": "硬件工程师", "why": "自动化专业电路、电子技术课程可支撑硬件设计、调试与测试类岗位。", "from_db": true, "db_level": "campus"}, {"title": "测试工程师", "why": "自动化专业具备信号检测与系统调试基础，适合软硬件测试与系统测试方向。", "from_db": true, "db_level": "campus"}, {"title": "算法工程师", "why": "自动化专业数学与控制算法基础可支撑算法工程师入口岗，偏控制、优化与信号处理方向。", "from_db": true, "db_level": "campus"}, {"title": "数据分析师", "why": "自动化专业数学与建模课程可迁移到数据分析岗，适合从数据清洗、指标分析做起。", "from_db": true, "db_level": "campus"}, {"title": "研发工程师", "why": "自动化专业工程实践基础适合投递研发工程师通用入口岗，偏电气、控制与系统方向。", "from_db": true, "db_level": "campus"}, {"title": "设备工程师", "why": "自动化专业熟悉电气控制与设备运行原理，适合设备维护、调试与管理类岗位。", "from_db": true, "db_level": "campus"}, {"title": "工艺工程师", "why": "自动化专业可投递工艺工程师，偏自动化产线工艺、设备工艺与制程控制方向。", "from_db": true, "db_level": "campus"}, {"title": "管培生", "why": "自动化专业工程背景适合投递技术类或综合类管培生，作为跨职能培养入口。", "from_db": true, "db_level": "campus"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 14:29:54", "_cg": {"name": "job_recommend_pool", "fp": "515b4e47f276", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 14:29:54", "extra": {}}}, "168399153cb1c41a2884": {"tier": 1, "mode": "llm", "items": [{"title": "自动化工程师", "why": "自动化专业最对口的通用校招入口，覆盖设备控制、产线调试等基础工程岗。", "from_db": true, "db_level": "other"}, {"title": "电气工程师", "why": "电气信息大类核心去向，校招中电气设计、配电与调试类岗位普遍开放给自动化本科生。", "from_db": true, "db_level": "campus"}, {"title": "控制工程师", "why": "自动化专业课程直接对应控制理论与系统实现，是校招里典型的对口研发/应用岗。", "from_db": true, "db_level": "campus"}, {"title": "嵌入式软件工程师", "why": "自动化专业普遍接触单片机与C语言，嵌入式开发是校招中接受该专业的基础软件岗。", "from_db": true, "db_level": "campus"}, {"title": "硬件工程师", "why": "自动化培养方案含电路、模电数电基础，硬件设计/测试类校招岗可投。", "from_db": true, "db_level": "campus"}, {"title": "测试工程师", "why": "自动化学生具备系统调试与信号测量基础，软硬件测试岗是校招常见入口。", "from_db": true, "db_level": "campus"}, {"title": "设备工程师", "why": "制造业校招中设备维护、安装调试类岗位对自动化专业需求稳定，应届可投。", "from_db": true, "db_level": "campus"}, {"title": "工艺工程师", "why": "自动化背景可支撑产线工艺与设备联调，制造类企业校招常设此入口。", "from_db": true, "db_level": "campus"}, {"title": "研发工程师", "why": "自动化专业可投通用研发岗，从事控制、电气或系统相关的基础研发工作。", "from_db": true, "db_level": "campus"}, {"title": "技术支持工程师", "why": "自动化设备与系统类企业校招常设技术支持岗，专业对口且应届可投。", "from_db": true, "db_level": "campus"}, {"title": "生产管培生", "why": "制造类企业校招管培生方向常面向自动化等工科专业，作为生产管理储备入口。", "from_db": true, "db_level": "campus"}, {"title": "销售工程师", "why": "自动化设备、电气类企业校招常设技术型销售岗，工科背景为常见要求。", "from_db": true, "db_level": "campus"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 14:30:28", "_cg": {"name": "job_recommend_pool", "fp": "515b4e47f276", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 14:30:28", "extra": {}}}, "16e2083fb6b7543fcbc6": {"tier": 0, "mode": "rules", "items": [{"title": "项目管理", "why": "企业库在招（非校招公告来源），与专业方向对口", "from_db": true, "db_level": "other"}, {"title": "项目管理工程师", "why": "校招公告里在招，与专业方向对口", "from_db": true, "db_level": "campus"}, {"title": "数据分析师", "why": "校招公告里在招，与专业方向对口", "from_db": true, "db_level": "campus"}, {"title": "数据分析", "why": "校招公告里在招，与专业方向对口", "from_db": true, "db_level": "campus"}, {"title": "数据分析岗", "why": "校招公告里