": "论文与竞赛都围绕发酵工艺优化展开，具备实验设计、正交试验与数据分析能力，可投食品方向研发工程师。", "from_db": true, "db_level": "campus"}, {"title": "工艺工程师", "why": "论文研究发酵温度与菌种配比对货架期品质的影响，竞赛测定发酵曲线，工艺工程师岗需要这种工艺参数优化能力。", "from_db": true, "db_level": "campus"}, {"title": "生产管培生", "why": "实习熟悉生产线取样与不合格品追溯流程，论文与竞赛体现工艺理解，生产管培生是食品专业常见校招入口。", "from_db": true, "db_level": "campus"}, {"title": "供应链管培生", "why": "实习参与不合格品追溯与整改跟踪，涉及批次追溯与品质异常处理，可衔接供应链质量与追溯方向管培岗。", "from_db": false, "db_level": "inferred"}, {"title": "数据分析师", "why": "论文用正交试验设计并处理发酵与货架期数据，掌握SPSS，竞赛做发酵曲线测定，数据分析岗能承接实验数据建模分析。", "from_db": true, "db_level": "campus"}, {"title": "食品法规专员", "why": "实习维护HACCP体系文件并跟踪整改，熟悉食品安全体系要求，法规与体系专员岗能对接合规文件与标准落地。", "from_db": false, "db_level": "inferred"}, {"title": "感官评价专员", "why": "掌握食品感官评价技能，论文涉及货架期品质变化研究，感官评价专员岗可直接用上品质评价与描述分析能力。", "from_db": false, "db_level": "inferred"}], "model": "deepseek-chat", "prompt_ver": "rec-v5", "ts": "2026-11-16 02:50:08", "_cg": {"name": "job_recommend_pool", "fp": "515b4e47f276", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 02:50:08", "extra": {}}}, "723a8b71c98d9b120c53": {"tier": 1, "mode": "llm", "items": [{"title": "食品研发工程师", "why": "食品科学与工程专业对口，毕业论文的发酵工艺优化与菌种配比研究可直接支撑研发岗的配方与工艺开发工作。", "from_db": false, "db_level": "inferred"}, {"title": "品控专员", "why": "品控部实习中做过生产线取样、菌落总数与大肠菌群检测及HACCP文件维护，与品控专员日常职责高度匹配。", "from_db": false, "db_level": "inferred"}, {"title": "质量工程师", "why": "微生物检测技能与不合格品追溯整改经验，可迁移到食品企业质量工程师的体系维护与异常处理工作。", "from_db": true, "db_level": "campus"}, {"title": "化验员", "why": "掌握微生物检测与HPLC操作，能胜任食品企业化验室的常规理化与微生物检验岗位。", "from_db": true, "db_level": "other"}, {"title": "生产管培生", "why": "食品工厂生产线实习经历与工艺优化背景，适合从生产管培生入口进入制造现场管理序列。", "from_db": true, "db_level": "campus"}, {"title": "供应链管培生", "why": "品控实习涉及不合格品追溯与整改跟踪，具备供应链质量与追溯环节的基础认知，可投供应链管培生。", "from_db": false, "db_level": "inferred"}, {"title": "研发管培生", "why": "食品创新大赛的乳酸菌发酵工艺优化经历与毕业论文研究，支撑研发管培生的工艺开发与实验设计能力。", "from_db": true, "db_level": "campus"}, {"title": "食品感官评价专员", "why": "技能栏明确列有食品感官评价，可对口食品企业感官评价与消费者测试类专员岗位。", "from_