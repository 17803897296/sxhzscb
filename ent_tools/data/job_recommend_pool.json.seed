e, "db_level": "campus"}, {"title": "控制工程师", "why": "毕业论文用模糊PID做注塑机料筒温度控制并完成Simulink仿真，是控制工程师岗位最直接的研究方向支撑。", "from_db": true, "db_level": "campus"}, {"title": "过程控制算法工程师", "why": "论文研究的料筒温度控制属于典型过程控制对象，模糊PID+Simulink建模经验与过程控制算法岗精准匹配。", "from_db": true, "db_level": "campus"}, {"title": "嵌入式软件工程师", "why": "电赛基于STM32完成直流电机闭环调速系统开发，具备嵌入式C语言编程与外设驱动调试的完整项目经验。", "from_db": true, "db_level": "campus"}, {"title": "嵌入式硬件工程师", "why": "电赛项目涉及STM32主控板与电机驱动电路搭建，硬件选型、电路调试与软硬联调经验可支撑嵌入式硬件岗。", "from_db": true, "db_level": "campus"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 15:11:54", "_cg": {"name": "job_recommend_pool", "fp": "7eb94246875e", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 15:11:54", "extra": {}}}, "af9c8bedfae4a6e98e6a": {"tier": 1, "mode": "llm", "items": [{"title": "电气工程师", "why": "自动化专业最对口的校招入口，PLC 调试与伺服整定经历可直接支撑产线电气设计与维护。", "from_db": true, "db_level": "campus"}, {"title": "自动化工程师", "why": "专业名称直接对应，设备部实习中的 PLC 程序调试与产线节拍优化是典型自动化岗位工作内容。", "from_db": true, "db_level": "other"}, {"title": "控制工程师", "why": "毕业论文做模糊 PID 温度控制、竞赛做电机闭环调速，控制方向的项目经历与岗位高度匹配。", "from_db": true, "db_level": "campus"}, {"title": "嵌入式软件工程师", "why": "基于 STM32 的直流电机闭环调速系统竞赛经历，加上 C 语言与 STM32 技能，是嵌入式岗位的直接支撑。", "from_db": true, "db_level": "campus"}, {"title": "硬件工程师", "why": "电子设计竞赛涉及 STM32 系统搭建与电机驱动电路，具备硬件设计与调试的校招入口基础。", "from_db": true, "db_level": "campus"}, {"title": "设备工程师", "why": "汽车零部件厂设备部实习直接对应设备维护、调试与产线设备管理类校招岗位。", "from_db": true, "db_level": "campus"}, {"title": "工艺工程师", "why": "产线节拍从 58s 降到 52s 的优化经历，体现对制造工艺与产线效率的理解，适合工艺类校招入口。", "from_db": true, "db_level": "campus"}, {"title": "测试工程师", "why": "竞赛中闭环调速系统的调试与验证、PLC 程序调试经历，可迁移到硬件/系统测试类岗位。", "from_db": true, "db_level": "campus"}, {"title": "电机控制算法工程师", "why": "竞赛做直流电机闭环调速、论文做模糊 PID 控制，电机控制算法方向有项目与建模仿真支撑。", "from_db": true, "db_level": "campus"}, {"title": "运动控制算法工程师", "why": "伺服驱动参数整定与电机闭环调速经历，对应运动控制算法岗位的校招入口。", "from_db": true, "db_level": "campus"}, {"title": "研发工程师", "why": "PLC、MATLAB/Simulink、STM32 等技能与竞赛论文经历，可投自动化相关产品研发类校招岗位。", "from_db": true, "db_level": "campus"}, {"title": "技术支持工程师", "why": "具备 PLC 调试、组态王与现场设备经验，适合自动化设备类企业的技术支持校招入口。", "from_db": true, "db_level": "campus"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 15:11:58", "_cg": {"name": "job_recommend_pool", "fp": "7eb94246875e", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 15:11:58", "extra": {}}}, "68f892fca94efe055e77": {"tier": 2, "mode": "llm", "items": [{"title": "电气工程师", "why": "自动化专业核心对口方向，PLC 调试与伺服整定经历直接支撑电气控制柜、产线电气系统相关工作。", "from_db": true, "db_level": "campus"}, {"title": "电控软件工程师", "why": "STM32 闭环调速竞赛与西门子 PLC 编程经验对应电控软件开发，属于电气信息大类可投的偏软控制岗。", "from_db": true, "db_level": "campus"}, {"title": "设备工程师", "why": "汽车零部件厂设备部实习直接对应产线设备维护、调试与节拍优化类岗位。", "from_db": true, "db_level": "campus"}, {"title": "自动化工程师", "why": "专业名称直接对口，PLC、组态王、伺服参数整定构成自动化产线实施与调试的基本技能组合。", "from_db": true, "db_level": "other"}, {"title": "测试工程师", "why": "电机闭环调速系统搭建与 Simulink 仿真验证经历可迁移到硬件/系统测试岗位。", "from_db": true, "db_level": "campus"}, {"title": "嵌入式软件工程师", "why": "STM32 与 C 语言竞赛项目是嵌入式软件开发岗的直接能力证据。", "from_db": true, "db_level": "campus"}, {"title": "硬件工程师", "why": "电子设计竞赛省二等奖涉及电机驱动电路与控制器搭建，支撑硬件调试与验证类岗位。", "from_db": true, "db_level": "campus"}, {"title": "控制工程师", "why": "模糊 PID 温度控制论文与 Simulink 建模对应控制算法实现与参数整定类岗位。", "from_db": true, "db_level": "campus"}, {"title": "工艺工程师", "why": "产线节拍从 58s 降到 52s 的改善经历对应制造工艺与产线优化类岗位。", "from_db": true, "db_level": "campus"}, {"title": "现场服务工程师", "why": "设备调试与 PLC 现场经验适合面向客户现场的安装调试与技术服务岗位。", "from_db": true, "db_level": "campus"}, {"title": "仪表工程师", "why": "温度控制论文涉及检测与执行环节，PLC 与组态王技能可迁移到仪表与自控系统维护。", "from_db": false, "db_level": "inferred"}, {"title": "生产计划助理专工", "why": "设备部实习中关注产线节拍与效率改善，具备从设备视角理解产能与计划的基础。", "from_db": true, "db_level": "campus"}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 15:12:03", "_cg": {"name": "job_recommend_pool", "fp": "7eb94246875e", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 15:12:03", "extra": {}}}, "57d81c706aa1297ca04e": {"tier": 3, "mode": "llm", "items": [{"title": "质量工程师", "why": "设备部实习中调试PLC与伺服参数、优化产线节拍，体现对设备运行细节和异常的关注，适合从质量工程师入口做起。", "from_db": true, "db_level": "campus"}, {"title": "生产管理管培生", "why": "产线节拍从58s降到52s的实习成果说明具备现场改善意识与组织协调潜力，生产管理管培生正需要这类通用能力。", "from_db": false, "db_level": "inferred"}, {"title": "生产计划专员", "why": "PLC调试与产线节拍优化经历培养了对生产节奏和资源匹配的敏感度，可迁移到生产计划专员岗位。", "from_db": false, "db_level": "inferred"}, {"title": "采购专员", "why": "设备部实习中接触伺服驱动等零部件，加上细致调试的工作习惯，适合从采购专员切入供应商与物料协调。", "from_db": true, "db_level": "campus"}, {"title": "供应商管理专员", "why": "实习中整定伺服驱动参数、排查设备问题，养成对来料与设备一致性的关注，可迁移到供应商管理专员。", "from_db": false, "db_level": "inferred"}, {"title": "技术销售工程师", "why": "具备PLC、STM32等实操背景，能把设备调试经验转化为对客户的技术沟通，适合技术销售工程师入口岗。", "from_db": false, "db_level": "inferred"}, {"title": "售前技术支持工程师", "why": "电子设计竞赛与PLC调试经历说明能理解客户现场需求并做基础技术方案沟通，适合售前技术支持工程师。", "from_db": false, "db_level": "inferred"}, {"title": "售后技术支持工程师", "why": "设备部实习中调试西门子PLC和伺服驱动，具备现场排障与客户沟通的通用底子，可投售后技术支持工程师。", "from_db": false, "db_level": "inferred"}, {"title": "项目助理", "why": "毕业论文用Simulink做模糊PID温度控制建模，体现按节点推进任务和文档整理能力，适合项目助理岗位。", "from_db": false, "db_level": "inferred"}, {"title": "测试工程师", "why": "STM32直流电机闭环调速系统竞赛经历包含搭建、调试与验证环节，测试工程师正需要这种细致验证的通用能力。", "from_db": true, "db_level": "campus"}, {"title": "仓储物流专员", "why": "产线节拍优化实习培养了对物料流动和现场节奏的理解，可迁移到仓储物流专员的日常协调工作。", "from_db": false, "db_level": "inferred"}, {"title": "EHS专员", "why": "设备部实习中参与产线设备调试，具备现场安全规范意识和细致执行习惯，适合从EHS专员入口做起。", "from_db": true, "db_level": "other"}, {"title": "质量管理专员", "why": "不看专业细分的通用职能岗，大量专业都能投", "from_db": false, "db_level": ""}, {"title": "质量检验员", "why": "不看专业细分的通用职能岗，大量专业都能投", "from_db": false, "db_level": ""}], "model": "deepseek-chat", "prompt_ver": "rec-v6", "ts": "2026-11-16 15:12:07", "_cg": {"name": "job_recommend_pool", "fp": "7eb94246875e", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-16 15:12:07", "extra": {}}}, "b78c7da032bdb95bc87f": {"tier": 4, "mode": "llm", "items": [