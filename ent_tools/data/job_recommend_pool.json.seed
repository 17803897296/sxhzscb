{"65bab19ae3dc3c95c5f4": {"tier": 0, "mode": "llm", "items": [{"title": "数据分析师", "why": "管理科学与工程专业具备定量分析与建模基础，数学建模类竞赛训练可直接迁移到业务数据清洗、指标搭建与结论输出。", "from_db": false}, {"title": "商业分析师", "why": "经管大类背景加上建模竞赛的分析能力，适合做市场与业务问题的结构化拆解、假设验证和商业决策支持。", "from_db": false}, {"title": "策略分析师", "why": "竞赛中的预测建模与方案比选经验可落到策略分析岗，用数据与模型支撑定价、资源配置等策略制定。", "from_db": false}, {"title": "算法研究员", "why": "数学建模竞赛体现的建模与求解能力，可支撑算法研究岗的模型设计、实验设计与效果评估。", "from_db": true}, {"title": "量化研究员", "why": "管理科学与工程中的优化与统计方法，加上竞赛建模训练，适合量化研究中的因子构建与回测分析。", "from_db": true}, {"title": "行业研究助理", "why": "治理策略、机制研究类论文培养的文献梳理与机制分析能力，可直接用于行业研究中的赛道梳理与逻辑推演。", "from_db": false}, {"title": "咨询分析师", "why": "论文中的机制研究与竞赛中的结构化建模，对应咨询分析岗的问题诊断、框架搭建与方案论证。", "from_db": false}, {"title": "供应链分析师", "why": "管理科学与工程的专业训练覆盖运筹与流程优化，竞赛建模能力可迁移到供应链的库存、计划与网络分析。", "from_db": false}, {"title": "项目管理专员", "why": "专业课程中的项目计划与进度控制知识，配合建模竞赛中的方案统筹经验，适合项目管理入口岗。", "from_db": false}, {"title": "产品经理", "why": "经管大类培养的需求分析与逻辑表达能力，加上竞赛中的方案设计训练，可支撑产品需求梳理与方案落地。", "from_db": true}, {"title": "管理培训生", "why": "管理学大类背景与建模分析能力，适合轮岗式管培生路径，在运营、计划、分析等职能间建立综合能力。", "from_db": false}, {"title": "商务专员", "why": "经管大类下的商务谈判、合同与客户管理知识，配合论文训练的逻辑写作能力，适合商务支持入口岗。", "from_db": false}], "model": "deepseek-chat", "prompt_ver": "rec-v3", "ts": "2026-11-15 02:29:38", "_cg": {"name": "job_recommend_pool", "fp": "f8a67cd6ae7a", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-15 02:29:38", "extra": {}}}, "f99ec826838d4da4413a": {"tier": 1, "mode": "llm", "items": [{"title": "管理培训生", "why": "管理科学与工程属管理学大类，校招管培生是经管类最主流的综合入口，不限实习经历。", "from_db": false}, {"title": "项目管理专员", "why": "专业核心课程覆盖项目计划、进度与资源协调，校招项目管理专员是直接对口的初级入口。", "from_db": true}, {"title": "数据分析师", "why": "管理科学与工程训练量化分析与建模思维，数据分析师是经管类学生投递量最大的分析岗之一。", "from_db": false}, {"title": "商业分析师", "why": "专业涉及运筹与决策分析，商业分析师面向业务问题做结构化分析，适合无实习的应届生入口。", "from_db": false}, {"title": "供应链专员", "why": "管理科学与工程常设运营与供应链方向，供应链专员是校招中该方向最基础的执行层岗位。", "from_db": false}, {"title": "运营专员", "why": "经管大类学生通用出口，运营专员侧重流程执行与数据跟踪，对实习经历要求相对宽松。", "from_db": false}, {"title": "产品经理", "why": "管理科学与工程具备需求分析与流程设计基础，校招产品经理是经管类学生常投的通用岗位。", "from_db": true}, {"title": "人力资源专员", "why": "管理学大类覆盖组织行为与人力资源管理知识，人资专员是校招中经管学生稳定可投的职能岗。", "from_db": true}, {"title": "财务助理", "why": "管理科学与工程含管理会计与财务基础模块，财务助理是校招财务方向对应届生开放的入门岗。", "from_db": true}, {"title": "市场专员", "why": "经管大类通用就业方向，市场专员侧重市场调研与活动执行，适合无实习经历的应届生起步。", "from_db": true}, {"title": "商务专员", "why": "管理科学与工程培养商务谈判与合同管理意识，商务专员是校招中经管类常见的初级商务入口。", "from_db": false}, {"title": "行政专员", "why": "管理学大类具备组织协调与公文处理基础，行政专员是校招职能类中对专业限制较宽的通用岗位。", "from_db": true}], "model": "deepseek-chat", "prompt_ver": "rec-v3", "ts": "2026-11-15 02:29:59", "_cg": {"name": "job_recommend_pool", "fp": "f8a67cd6ae7a", "model": "deepseek-chat", "schema": 1, "ts": "2026-11-15 02:29:59", "extra": {}}}, "f1fd17deb755d96e06fa": {"tier": 2, "mode": "llm", "items": [{"title": "管培生", "why": "管理学大类通用入口岗位，不限制细分专业，适合无实习无技能标签的应届生从轮岗中建立职业方向。", "from_db": false}, {"title": "职能管培生", "why": "面向经管大类培养职能序列人才，管理科学与工程专业的管理学基础可直接迁移到人力、行政、运营等职能轮岗。", "from_db": false}, {"title": "储备干部", "why": "多数企业面向管理学大类设置的基层管理储备入口，不要求特定细分专业或实习经历。", "from_db": false}, {"title": "运营培训生", "why": "运营类培训生岗位看重逻辑与统筹能力，管理科学与工程专业的系统思维训练可支撑运营流程理解。", "from_db": false}, {"title": "业务运营岗", "why": "业务运营属于经管大类通用岗位，侧重流程推进与跨部门协调，不要求专门技术技能。", "from_db": false}, {"title": "产品运营岗", "why": "产品运营岗对专业限制较宽，管理学背景可迁移到需求梳理、用户反馈与运营策略执行。", "from_db": false}, {"title": "市场商务岗", "why": "市场商务类岗位面向经管大类开放，管理科学与工程的市场与商务基础课程可支撑岗位入门。", "from_db": false}, {"title": "项目管理岗", "why": "项目管理岗需要计划、协调与进度控制能力，管理科学与工程专业的运筹与项目管理类课程直接对应。", "from_db": false}, {"title": "客户成功专员", "why": "客户成功专员属于经管大类通用服务型岗位，侧重客户沟通与需求跟进，不设细分专业门槛。", "from_db": false}, {"title": "商业分析岗", "why": "商业分析岗面向管理学大类，管理科学与工程专业的数据分析与决策方法训练可支撑业务分析入门。", "from_db": false}, {"title": "数据分析岗", "why": "数据分析岗接受经管大类背景，管理科学与工程专业通常具备统计与数据工具基础，可投初级分析入口。", "from_db": false}, {"title": "经营分析岗", "why": "经营分析岗侧重经营数据解读与业务诊断，管理学大类的财务与运营知识可迁移到该岗位。", "from_db": false}], "model": "deepseek-chat", "prompt_ver": "rec-v3", "ts": "2026-11-15