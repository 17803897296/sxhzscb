# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地环境变量（大模型 key 等，绝不入库）
.env
*.env.local

# SQLite 运行时副产物
*.db-shm
*.db-wal
*.seed-shm
*.seed-wal
# 离线全量变体构建产物：sync_offline.py 同步时现场生成，不入库
demo_offline/
# 运行时活库不入库：仓库只放只读种子 careersafari.db.seed，
# 服务首次启动自动复制。git 操作碰到正在写入的 db 会把它写成 malformed。
ent_tools/data/careersafari.db

# 演示时浏览器/脚本产生的临时文件
_lp.json
_p.json
live_payload_tmp.json
*.log

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 一次性调试脚本 / 本地夹具（本机保留，永不入库）
ent_tools/_*.py
# 流水线第二步（refresh_all 2/8）直接调它，必须入库
!ent_tools/_dir_fill.py
ent_tools/_*.js
ent_tools/_*.json
# 例外：回归测试的旧规则基线模块，clone 跑 _rule_regress.py 必须有
!ent_tools/_is_old_tmp.py
# 例外：无头渲染 A/B 工具。它是「渲染路径改动到底快了多少、正文有没有变」
# 的唯一证据来源，文档里直接让人跑它，所以必须随仓库走。
!ent_tools/_js_ab.py
# 测试运行时生成的差异报告（不入库）
ent_tools/data/_parity_diff.json

# 含真实姓名的个人报告页 / 采集数据页（本机保留，永不入库）
demo/排行_*.html
demo/ranking_*.html
demo/采集数据_*.html

# 一次性脚本留档（考古用，不入库）：它们只解释「当时为什么这么改」，
# 真正的口径已经写进 tests/ 和 docs/。见 ent_tools/scratch/README.md
ent_tools/scratch/

# 备份与本地缓存（不入库）
*.bak_*
ent_tools/test_photos/

# 运行时活缓存不入库：仓库只放只读种子 X.seed，服务/构建启动时自动复制出活文件 X。
# 这些文件服务一处理请求就会改写，一旦被 git 跟踪，clone 出来什么都没干就已经是
# 脏的——新人会以为自己搞坏了，然后 git checkout 把刚算出的结论撤掉。
# 活库 careersafari.db 早就用同一套办法解决了，缓存原来没跟上。
# 重新冻结种子：cd ent_tools && python -X utf8 cache_guard.py freeze
ent_tools/data/*_cache.json
ent_tools/data/intent_semantics_live.json
ent_tools/data/job_recommend_pool.json
ent_tools/data/hit_verdicts.json
ent_tools/data/lookup_cache.json

# 本地改动前快照 / 临时脚本产物（每次改动都会生成，不该进版本库）
_bak_*/
_tmp*/
_tmp_resume_test/
ent_tools/_stale_cache/
ent_tools/data/_stale_cache/
ent_tools/.runtime/
ent_tools/.env.*.bak_*
# data/ 下的本地快照与审计产物；两个例外是门禁要用的夹具（见 sync_repo.TEST_ASSETS）
ent_tools/data/_profile_backup_before_*.json
ent_tools/data/_rec_pool_audit.json

# 采集期临时产物：页面正文缓存（体积大、可重建）、未抓到名单、待采名单快照
ent_tools/data/_pages/
ent_tools/data/_roster_miss.json
ent_tools/data/_roster_todo.json

# 页面构建戳：build_fair_page.py 每次构建都刷新，入库等于永远 dirty。
# clone 出来第一件事就是构建一次页面，戳会自己长出来。
ent_tools/data/.page_stamp.json

# v3.0 发布前补盖：测试/并行期间的活库副本、本机备份目录与临时名单
*.db
ent_tools/data/_backup_before_*/
ent_tools/data/_*_names.txt
demo/*.old.html
# 主营复核诊断清单：开发期调词表/补采集的一次性产物，不进库
ent_tools/data/_recheck_diag.json
