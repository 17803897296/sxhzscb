# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地环境变量（大模型 key 等，绝不入库）
.env
*.env.local

# SQLite 运行时副产物
*.db-shm
*.db-wal
*.seed-shm
*.seed-wal
# 运行时活库不入库：仓库只放只读种子 careersafari.db.seed，
# 服务首次启动自动复制。git 操作碰到正在写入的 db 会把它写成 malformed。
ent_tools/data/careersafari.db

# 演示时浏览器/脚本产生的临时文件
_lp.json
_p.json
live_payload_tmp.json
*.log

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 一次性调试脚本 / 本地夹具（本机保留，永不入库）
ent_tools/_*.py
ent_tools/_*.js
ent_tools/_*.json

# 含真实姓名的个人报告页 / 采集数据页（本机保留，永不入库）
demo/排行_*.html
demo/ranking_*.html
demo/采集数据_*.html

# 备份与本地缓存（不入库）
*.bak_*
ent_tools/data/hard_filter_cache.json
ent_tools/test_photos/

# 本地改动前快照 / 临时脚本产物（每次改动都会生成，不该进版本库）
_bak_*/
_tmp*/
_tmp_resume_test/
ent_tools/_stale_cache/
ent_tools/data/_stale_cache/
ent_tools/.runtime/
ent_tools/.env.*.bak_*
